{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/api",
      "framework": "fastapi"
    }
  },
  "crons": [
    {
      "path": "/api/games/internal/warm-popular",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/game-groups/search",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=2592000, stale-while-revalidate=7776000"
        }
      ]
    },
    {
      "source": "/api/games/search",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/games/artwork",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
