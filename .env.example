IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret
# Optional shared HLTB cache. In Vercel, install Upstash Redis and use the
# injected KV_REST_API_URL and KV_REST_API_TOKEN environment variables.
# KV_REST_API_URL=https://your-cache.upstash.io
# KV_REST_API_TOKEN=your-upstash-token
# Change this value and redeploy when an HLTB lookup or mapping change needs to
# bypass cached results. It only affects the HLTB shared cache namespace.
HLTB_CACHE_VERSION=v2

# Optional RAWG enrichment. Search payloads remain fresh for 45 days and group
# memberships for 60 days, with stale-while-revalidate after each fresh window.
# The daily warmer uses the same shared Redis cache and only spends RAWG calls
# on missing or expired seeds.
RAWG_API_KEY=your-rawg-api-key
# Number of popular games used to seed RAWG group records (default: 5, max: 10).
WARM_GAME_GROUP_LIMIT=5

# Vercel Cron authorizes the popular-game cache warmer with this secret.
# CRON_SECRET=generate-a-random-secret-at-least-16-characters-long
# Optional number of IGDB's most-visited games to warm (default: 20, max: 50).
# WARM_CACHE_GAME_LIMIT=20
